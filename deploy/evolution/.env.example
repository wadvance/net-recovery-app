# URL pública de tu Evolution (sin / al final). En VPS con dominio + HTTPS.
SERVER_URL=https://evo.tu-dominio.com
# Puerto local del contenedor
EVOLUTION_PORT=8080
# API key MAESTRA de tu Evolution (genera una larga, solo tuya, no la compartas)
EVOLUTION_API_KEY=CAMBIA_ESTA_CLAVE_LARGA_Y_UNICA
# Límite de QR antes de bloquear (anti-abuso)
QRCODE_LIMIT=30
# Postgres interno del compose
POSTGRES_USER=evolution
POSTGRES_PASSWORD=CAMBIA_PASSWORD_POSTGRES
POSTGRES_DB=evolution
